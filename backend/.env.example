# Anemia Care API - config lokal (jangan di-commit, isi sesuai environment)
PORT=3000

# URL sidecar ML (FastAPI). Kosongkan = mode MOCK (prediksi simulasi, jelas berlabel "mock").
# Contoh: ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_URL=

# --- Persistensi Postgres (TypeORM) ---
# Kosongkan DB_HOST = riwayat disimpan di memori (default untuk unit/e2e test).
# Isi saat ada Postgres (lokal/VM via docker compose sudah otomatis di-set).
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Auth JWT (petugas/admin) ---
JWT_SECRET=anemia-care-dev-secret
# Seed admin otomatis saat tabel petugas kosong (DB mode)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123